// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// No `binaryTargets` here on purpose (Dockerization prep, 2026-08-20): this
// generator + the @prisma/adapter-pg driver adapter (see PrismaService) means
// query execution goes through a portable WASM query compiler
// (`query_compiler_fast_bg.postgresql.wasm-base64.js`, verified in
// src/generated/prisma/internal/class.ts), not a platform-specific native
// binary — so the classic "wrong libc/OpenSSL in the container" binaryTargets
// problem doesn't apply to the client. The one native binary still in play is
// @prisma/engines' schema-engine (used by `prisma migrate deploy`/`db push`,
// not by the running app) — currently cached as schema-engine-debian-openssl-3.0.x,
// which is why the Docker plan uses a Debian/`-slim` base (not Alpine/musl)
// for whichever stage runs migrations, avoiding a musl-variant download fight.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime       @default(now())
  users     User[]
  modules   TenantModule[]
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ANALYST
  VIEWER
}

model User {
  id                       String            @id @default(uuid()) @db.Uuid
  email                    String            @unique
  phoneNumber              String
  name                     String
  role                     UserRole          @default(VIEWER)
  hashedPassword           String
  tenantId                 String?           @db.Uuid
  tenant                   Tenant?           @relation(fields: [tenantId], references: [id])
  passwordResetRequestedAt DateTime?
  mustChangePassword       Boolean           @default(false)
  failedLoginAttempts      Int               @default(0)
  lockedUntil              DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  refreshTokens            RefreshToken[]
  passwordHistory          PasswordHistory[]

  @@index([tenantId])
}

model PasswordHistory {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id])
  hashedPassword String
  createdAt      DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  user              User      @relation(fields: [userId], references: [id])
  tokenHash         String    @unique
  familyId          String    @db.Uuid
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @db.Uuid
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

enum ModuleName {
  SIEM
  SOAR
  CTI
  EDR
  DFIR
  VM
}

model TenantModule {
  id         String     @id @default(uuid()) @db.Uuid
  tenantId   String     @db.Uuid
  tenant     Tenant     @relation(fields: [tenantId], references: [id])
  config     Json?
  isActive   Boolean    @default(true)
  moduleName ModuleName

  @@unique([tenantId, moduleName])
  @@index([tenantId])
}
