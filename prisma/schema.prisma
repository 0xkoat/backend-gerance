// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

// No `binaryTargets` here on purpose (Dockerization prep, 2026-08-20): this
// generator + the @prisma/adapter-pg driver adapter (see PrismaService) means
// query execution goes through a portable WASM query compiler
// (`query_compiler_fast_bg.postgresql.wasm-base64.js`, verified in
// src/generated/prisma/internal/class.ts), not a platform-specific native
// binary — so the classic "wrong libc/OpenSSL in the container" binaryTargets
// problem doesn't apply to the client. The one native binary still in play is
// @prisma/engines' schema-engine (used by `prisma migrate deploy`/`db push`,
// not by the running app) — currently cached as schema-engine-debian-openssl-3.0.x,
// which is why the Docker plan uses a Debian/`-slim` base (not Alpine/musl)
// for whichever stage runs migrations, avoiding a musl-variant download fight.
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id        String         @id @default(uuid()) @db.Uuid
  name      String
  createdAt DateTime       @default(now())
  users     User[]
  modules   TenantModule[]
}

enum UserRole {
  SUPER_ADMIN
  INTEGRATION_ADMIN
  ADMIN
  ANALYST
}

// Required for ANALYST, NULL for every other role — enforced by the
// User_analystLevel_matches_role CHECK constraint (raw SQL in the migration,
// Prisma schema can't express it).
enum AnalystLevel {
  L1
  L2
  L3
}

model User {
  id                       String            @id @default(uuid()) @db.Uuid
  email                    String            @unique
  phoneNumber              String
  name                     String
  role                     UserRole
  analystLevel             AnalystLevel?
  hashedPassword           String
  tenantId                 String?           @db.Uuid
  tenant                   Tenant?           @relation(fields: [tenantId], references: [id])
  passwordResetRequestedAt DateTime?
  mustChangePassword       Boolean           @default(false)
  failedLoginAttempts      Int               @default(0)
  lockedUntil              DateTime?
  createdAt                DateTime          @default(now())
  updatedAt                DateTime          @updatedAt
  refreshTokens            RefreshToken[]
  passwordHistory          PasswordHistory[]

  @@index([tenantId])
}

model PasswordHistory {
  id             String   @id @default(uuid()) @db.Uuid
  userId         String   @db.Uuid
  user           User     @relation(fields: [userId], references: [id])
  hashedPassword String
  createdAt      DateTime @default(now())

  @@index([userId])
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  userId            String    @db.Uuid
  user              User      @relation(fields: [userId], references: [id])
  tokenHash         String    @unique
  familyId          String    @db.Uuid
  expiresAt         DateTime
  revokedAt         DateTime?
  replacedByTokenId String?   @db.Uuid
  createdAt         DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
}

enum ModuleName {
  SIEM
  SOAR
  CTI
  EDR
  DFIR
  VM
}

// A tenant's subscription to one module (activated by a Super Admin) plus the
// minimum analyst level that may launch it in that tenant (set by the
// tenant's own Admin). Admins can always launch an active module.
model TenantModule {
  id              String       @id @default(uuid()) @db.Uuid
  tenantId        String       @db.Uuid
  tenant          Tenant       @relation(fields: [tenantId], references: [id])
  isActive        Boolean      @default(true)
  moduleName      ModuleName
  minAnalystLevel AnalystLevel @default(L1)

  @@unique([tenantId, moduleName])
  @@index([tenantId])
}

enum ModuleProtocol {
  HTTP
  HTTPS
}

// Where each module's single, platform-wide instance lives (a private
// IP:PORT, not public). One row per ModuleName, created by the migration;
// only an Integration Admin edits it. host/port stay NULL until configured,
// and an unconfigured module can't be launched.
model ModuleEndpoint {
  moduleName  ModuleName     @id
  protocol    ModuleProtocol @default(HTTPS)
  host        String?
  port        Int?
  path        String         @default("/")
  updatedAt   DateTime       @updatedAt
  // Plain id, no relation: the audit value shouldn't block deleting that
  // Integration Admin.
  updatedById String?        @db.Uuid
}

// Append-only audit of module launches. Snapshot columns, no relations, so
// history survives user and tenant deletion.
model ModuleLaunch {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @db.Uuid
  userEmail  String
  role       UserRole
  tenantId   String     @db.Uuid
  moduleName ModuleName
  targetUrl  String
  launchedAt DateTime   @default(now())

  @@index([tenantId, launchedAt])
}
