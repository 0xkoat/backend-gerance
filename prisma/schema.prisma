// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Tenant {
  id                  String         @id @default(uuid()) @db.Uuid
  name                String
  createdAt           DateTime       @default(now())
  users               User[]
  modules             TenantModule[]
  vmAssets            VmAsset[]
  vmVulnerabilities   VmVulnerability[]
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  ANALYST
  VIEWER
}

model User {
  id                       String    @id @default(uuid()) @db.Uuid
  email                    String    @unique
  phoneNumber              String
  name                     String
  role                     UserRole  @default(VIEWER)
  hashedPassword           String
  tenantId                 String?  @db.Uuid
  tenant                   Tenant?  @relation(fields: [tenantId], references: [id])
  passwordResetRequestedAt DateTime?
  mustChangePassword       Boolean   @default(false)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  @@index([tenantId])
}

enum ModuleName {
  SIEM
  SOAR
  CTI
  EDR
  DFIR
  VM
}

enum Severity {
  LOW
  MEDIUM
  HIGH
  CRITICAL  
}

enum VmVulnerabilitiesStatus {
  OPEN
  REMEDIATED
  ACCEPTED_RISK
}

model TenantModule {
  id         String           @id @default(uuid()) @db.Uuid
  tenantId   String           @db.Uuid
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  config     Json?
  isActive   Boolean          @default(true)
  moduleName ModuleName

  @@unique([tenantId, moduleName])
  @@index([tenantId])
}

model VmAsset {
  id                String           @id @default(uuid()) @db.Uuid
  tenantId          String           @db.Uuid
  tenant            Tenant           @relation(fields: [tenantId], references: [id])
  name              String
  ip                String
  type              String
  createdAt         DateTime         @default(now())
  vmVulnerabilities VmVulnerability[]
  
  @@index([tenantId])
  @@unique([tenantId, ip])
}

model VmVulnerability {
  id         String                           @id @default(uuid()) @db.Uuid
  tenantId   String                           @db.Uuid
  tenant     Tenant                           @relation(fields: [tenantId], references: [id])
  assetId    String                           @db.Uuid
  asset      VmAsset                          @relation(fields: [assetId], references: [id])
  severity   Severity
  description String
  createdAt  DateTime                         @default(now())
  cveId     String?
  status     VmVulnerabilitiesStatus          @default(OPEN)
  rawData    Json?

  @@index([tenantId])
}